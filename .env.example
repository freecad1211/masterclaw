FORGECLAW_DATABASE_PATH=./data/forgeclaw.sqlite3
FORGECLAW_DEBATE_MAX_ROUNDS=3

# Any provider exposing an OpenAI-compatible POST /chat/completions endpoint.
# Example format: https://provider.example/v1 (replace with your actual provider URL).
# Keep secrets in .env or your host's secret manager; never commit real keys.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=60

# Obsidian integration is not implemented yet. These are reserved for a future adapter.
OBSIDIAN_BASE_URL=
OBSIDIAN_API_TOKEN=
