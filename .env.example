FORGECLAW_DATABASE_PATH=./data/forgeclaw.sqlite3
FORGECLAW_DEBATE_MAX_ROUNDS=3

# Default provider for roles without an override.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=60

# Optional role-specific overrides; unset values inherit global LLM_* settings.
FORGECLAW_AGENT_ARCHITECT_BASE_URL=
FORGECLAW_AGENT_ARCHITECT_API_KEY=
FORGECLAW_AGENT_ARCHITECT_MODEL=
FORGECLAW_AGENT_IMPLEMENTER_BASE_URL=
FORGECLAW_AGENT_IMPLEMENTER_API_KEY=
FORGECLAW_AGENT_IMPLEMENTER_MODEL=
FORGECLAW_AGENT_REVIEWER_BASE_URL=
FORGECLAW_AGENT_REVIEWER_API_KEY=
FORGECLAW_AGENT_REVIEWER_MODEL=
FORGECLAW_AGENT_TESTER_BASE_URL=
FORGECLAW_AGENT_TESTER_API_KEY=
FORGECLAW_AGENT_TESTER_MODEL=
FORGECLAW_AGENT_INTEGRATOR_BASE_URL=
FORGECLAW_AGENT_INTEGRATOR_API_KEY=
FORGECLAW_AGENT_INTEGRATOR_MODEL=

# The MCP server uses this workspace when launched outside the project root.
FORGECLAW_MCP_WORKSPACE=
# Local Git commit identity for autonomous branches (does not alter global Git config).
GIT_AUTHOR_NAME=ForgeClaw Agent
GIT_AUTHOR_EMAIL=forgeclaw@localhost
GIT_COMMITTER_NAME=ForgeClaw Agent
GIT_COMMITTER_EMAIL=forgeclaw@localhost

# Obsidian integration remains a future adapter.
OBSIDIAN_BASE_URL=
OBSIDIAN_API_TOKEN=
